set(OPENPRESSOD_SERVICE_NAME openpressod)
set(OPENPRESSOD_SYSTEM_USER openpressod)
set(OPENPRESSOD_DATA_DIR /var/lib/openpressod)
set(OPENPRESSOD_RUNTIME_DIR_NAME openpresso)
set(OPENPRESSOD_RUNTIME_DIR_PATH /run/${OPENPRESSOD_RUNTIME_DIR_NAME})
set(OPENPRESSOD_SOCKET_PATH ${OPENPRESSOD_RUNTIME_DIR_PATH}/openpresso.sock)
set(OPENPRESSOD_BIN_DIR /usr/bin)
set(OPENPRESSOD_CONFIG_DIR /etc/openpressod)
set(OPENPRESSOD_CONFIG_NAME config.toml)
set(OPENPRESSOD_CONFIG_EXAMPLE_NAME config.toml.example)
set(OPENPRESSOD_CONFIG_EXAMPLE_PATH ${OPENPRESSOD_CONFIG_DIR}/${OPENPRESSOD_CONFIG_EXAMPLE_NAME})
set(OPENPRESSOD_CONFIG_PATH ${OPENPRESSOD_CONFIG_DIR}/${OPENPRESSOD_CONFIG_NAME})
